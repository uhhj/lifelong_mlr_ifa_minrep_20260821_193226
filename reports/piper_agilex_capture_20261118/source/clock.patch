 COMMAND_IDS = (*range(0x150,0x160), 0x470, 0x471, 0x475)
 READ_IDS = (*FIDS, 0x2A1, 0x2A8, *range(0x261, 0x267), 0x473)
 FOLLOWER_TARGET_IDS = (0x151, *JIDS, 0x159)
+NS_PER_SECOND = 1_000_000_000
+CAN_CLOCK_TOLERANCE_NS = 20_000_000
+CAN_MAX_AGE_NS = 100_000_000
+
+
+class CanClock:
+    """Project SocketCAN realtime stamps onto one monotonic axis per session."""
+
+    def __init__(self, realtime_offset_ns=None):
+        if realtime_offset_ns is None:
+            anchors = []
+            for _ in range(5):
+                before = time.monotonic_ns()
+                wall = time.time_ns()
+                after = time.monotonic_ns()
+                anchors.append((after - before, wall - (before + after) // 2))
+            _, realtime_offset_ns = min(anchors)
+        self.realtime_offset_ns = realtime_offset_ns
+
+    def project(self, kernel_ns, observed_ns):
+        return min(kernel_ns - self.realtime_offset_ns, observed_ns)
+
+    def age(self, kernel_ns, wall_ns, observed_ns):
+        wall_age = wall_ns - kernel_ns
+        clock_error = wall_ns - self.realtime_offset_ns - observed_ns
+        require(abs(clock_error) <= CAN_CLOCK_TOLERANCE_NS
+                and wall_age >= -CAN_CLOCK_TOLERANCE_NS, 'CAN clock discontinuity')
+        return max(wall_age, observed_ns - self.project(kernel_ns, observed_ns))
 
 

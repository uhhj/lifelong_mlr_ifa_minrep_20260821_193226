 class RuntimeChecks(unittest.TestCase):
+    def test_raw_rx_tx_echo_and_failed_tx_share_monotonic_timeline(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory)
+            session = Session(SimpleNamespace(follow=True), path, trace_can=True)
+            session.active = True
+            session.safety = lambda: None
+
+            def message(cid, timestamp, data, is_rx=True):
+                return SimpleNamespace(arbitration_id=cid, data=data, timestamp=timestamp,
+                                       is_error_frame=False, is_extended_id=False,
+                                       is_remote_frame=False, is_rx=is_rx)
+
+            def bus(*messages):
+                pending = iter(messages)
+                return SimpleNamespace(recv=lambda timeout: next(pending, None))
+
+            target = struct.pack('>ii', -2000, 1000)
+            wall = time.time()
+            mono = time.monotonic()
+            leader = bus(message(0x157,wall-.001,target))
+            follower = bus(message(0x2A7,wall+.002,target))
+            echo = bus(message(0x157,wall+.001,target,False),
+                       message(0x157,wall+.001,target))
+            session.buses = {'can0': follower, 'can1': leader}
+            session.target_echo = echo
+            with patch('transport_base.select.select',return_value=([leader],[],[])), \
+                 patch('transport_base.time.time',return_value=wall), \
+                 patch('transport_base.time.monotonic',return_value=mono):
+                session.drain()
+            with patch('transport_base.raw_send') as send:
+                session.send('can0',0x157,target,source_mono=session.src.wire.values[0x157][1])
+                send.assert_called_once_with(follower,0x157,target)
+                send.side_effect = OSError('simulated transmit failure')
+                with self.assertRaisesRegex(OSError,'simulated'):
+                    session.send('can0',0x157,bytes(8))
+            with patch('transport_base.select.select',return_value=([follower,echo],[],[])), \
+                 patch('transport_base.time.time',return_value=wall+.003), \
+                 patch('transport_base.time.monotonic',return_value=mono+.003):
+                session.drain()
+            session.rec.close()
+            events = [json.loads(line) for line in (path/'can_timeline.jsonl').read_text().splitlines()]
+            self.assertEqual([e['kind'] for e in events],[
+                'master_rx','follower_target_tx_accepted','follower_target_tx_failed',
+                'follower_rx','can0_tx_echo'])
+            self.assertEqual([events[i]['data_hex'] for i in (0,1,3,4)],[target.hex()]*4)
+            self.assertEqual(events[0]['mono_ns'],events[1]['source_mono_ns'])
+            self.assertLessEqual(events[1]['send_begin_mono_ns'],events[1]['mono_ns'])
+            self.assertLess(events[4]['mono_ns'],events[3]['mono_ns'])
+            self.assertEqual(session.tx,1)

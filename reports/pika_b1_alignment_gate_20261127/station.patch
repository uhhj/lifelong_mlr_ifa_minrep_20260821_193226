diff --git a/b1_alignment_gate.py b/b1_alignment_gate.py
new file mode 100644
--- /dev/null
+++ b/b1_alignment_gate.py
@@ -0,0 +1,43 @@
+"""Alignment evidence for the installed B1 wrist view (640 x 480), in pixels."""
+import cv2
+import numpy as np
+
+
+# This coarse overhead estimate has a measured 21.3 mm 90th-percentile
+# registration error. The wrist checks the cube between the fingers directly.
+OVERHEAD_TOLERANCE_MM = 20.
+
+
+def wrist_block(wrist):
+    # Grey-brown front face of the wooden cube. Use its silhouette as well as
+    # colour so a yellow marker or a dark finger cannot stand in for the cube.
+    small = cv2.resize(wrist[200:480, 160:560], (200, 140), interpolation=cv2.INTER_AREA)
+    lab = cv2.cvtColor(small, cv2.COLOR_BGR2LAB)
+    # The block's left and right edges can meet paper of similar colour.
+    # An edge-bounded region stays separate from that paper in the mask.
+    mask = cv2.inRange(lab, (28, 113, 132), (172, 150, 152))
+    kernel = np.ones((3, 3), np.uint8)
+    mask = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, kernel)
+    edges = cv2.Canny(small, 25, 65)
+    mask[cv2.dilate(edges, kernel) != 0] = 0
+    mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, kernel)
+    components = cv2.connectedComponentsWithStats(mask, connectivity=8)[2][1:]
+    boxes = []
+    for left, top, width, height, area in components:
+        if (left <= 1 or left + width >= 199 or top < 2 or
+                not 46 <= width <= 99 or not 34 <= height <= 105 or
+                not .58 <= width / height <= 2.1 or area < .60 * width * height):
+            continue
+        boxes.append((int(160 + 2*left), int(200 + 2*top), int(2*width), int(2*height)))
+    return boxes[0] if len(boxes) == 1 else None
+
+
+def wrist_centered(box, opening):
+    if box is None:
+        return False
+    left, top, width, height = box
+    # The finger pads bracket the front face in successful B1 wrist images.
+    # Requiring the face to reach their depth excludes blocks at the far edge.
+    clearance_px = max(0., (opening - 35.)/2 - 2.) * width/35.
+    return (clearance_px > 0 and abs(left + width/2 - 355) <= min(42.,clearance_px)
+            and 276 <= top <= 372 and top + height >= 405)

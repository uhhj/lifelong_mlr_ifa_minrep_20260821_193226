+++ b/teleop_binding/test_heartbeat.py
@@ -0,0 +1,99 @@
+import json
+import os
+from pathlib import Path
+import tempfile
+import time
+import unittest
+from unittest.mock import patch
+
+from core import Abort
+from heartbeat import PipeHeartbeat
+from transport_base import Recorder
+
+
+class HeartbeatChecks(unittest.TestCase):
+    def setUp(self):
+        self.reader, self.writer = os.pipe()
+        self.addCleanup(os.close, self.reader)
+        self.addCleanup(self.close_writer)
+        self.events = []
+        self.heartbeat = PipeHeartbeat(self.reader, self.events.append)
+
+    def close_writer(self):
+        if self.writer is not None:
+            os.close(self.writer)
+            self.writer = None
+
+    def send(self, stamp):
+        os.write(self.writer, f'{stamp}\n'.encode('ascii'))
+
+    def test_partial_messages_preserve_interval_and_pipe_delay(self):
+        self.send(1_000_000_000)
+        with patch('heartbeat.time.monotonic_ns', return_value=1_005_000_000):
+            self.heartbeat.wait_ready()
+        os.write(self.writer, b'1100')
+        with patch('heartbeat.time.monotonic_ns', return_value=1_102_000_000):
+            self.heartbeat.check()
+        self.assertEqual(len(self.events), 1)
+        os.write(self.writer, b'000000\n')
+        with patch('heartbeat.time.monotonic_ns', return_value=1_107_000_000):
+            self.heartbeat.check()
+        self.assertEqual(self.events[-1]['interval_ms'], 100)
+        self.assertEqual(self.events[-1]['receive_interval_ms'], 102)
+        self.assertEqual(self.events[-1]['pipe_delay_ms'], 7)
+
+    def test_timeout_at_exactly_500_ms(self):
+        self.send(1_000_000_000)
+        with patch('heartbeat.time.monotonic_ns', return_value=1_499_999_999):
+            self.heartbeat.check()
+        with patch('heartbeat.time.monotonic_ns', return_value=1_500_000_000):
+            with self.assertRaisesRegex(Abort, 'heartbeat lost'):
+                self.heartbeat.check()
+        self.assertEqual(self.events[-1]['age_ms'], 500)
+
+    def test_late_heartbeat_in_pipe_cannot_mask_missing_interval(self):
+        self.send(1_000_000_000)
+        self.send(1_500_000_000)
+        with patch('heartbeat.time.monotonic_ns', return_value=1_505_000_000):
+            with self.assertRaisesRegex(Abort, 'heartbeat lost'):
+                self.heartbeat.check()
+        self.assertEqual(self.events[-2]['interval_ms'], 500)
+        self.assertEqual(self.events[-1]['last_gui_mono_ns'], 1_000_000_000)
+
+    def test_pipe_closed_even_with_a_buffered_fresh_heartbeat(self):
+        self.send(1_000_000_000)
+        self.close_writer()
+        with patch('heartbeat.time.monotonic_ns', return_value=1_005_000_000):
+            with self.assertRaisesRegex(Abort, 'pipe closed'):
+                self.heartbeat.check()
+
+    def test_startup_wait_is_bounded_before_first_heartbeat(self):
+        with patch('heartbeat.select.select', return_value=([], [], [])):
+            with self.assertRaisesRegex(Abort, 'not received before startup'):
+                self.heartbeat.wait_ready()
+
+    def test_future_timestamp_does_not_extend_protection_deadline(self):
+        self.send(1_005_000_001)
+        with patch('heartbeat.time.monotonic_ns', return_value=1_005_000_000):
+            with self.assertRaisesRegex(Abort, 'invalid timestamp'):
+                self.heartbeat.check()
+
+    def test_intervals_and_stop_reason_are_written_to_the_run_log(self):
+        with tempfile.TemporaryDirectory() as directory:
+            recorder = Recorder(Path(directory), trace_can=True)
+            self.heartbeat.record = recorder.record_heartbeat
+            now = time.monotonic_ns()
+            try:
+                self.send(now - 500_000_000)
+                self.send(now - 400_000_000)
+                self.heartbeat.check()
+                self.close_writer()
+                with self.assertRaisesRegex(Abort, 'pipe closed'):
+                    self.heartbeat.check()
+            finally:
+                recorder.close()
+            path = Path(directory)/'heartbeat.jsonl'
+            entries = [json.loads(line) for line in path.read_text().splitlines()]
+            self.assertIsNone(entries[0]['interval_ms'])
+            self.assertEqual(entries[1]['interval_ms'], 100)
+            self.assertEqual(entries[2]['detail'], 'pipe closed')

@@ -0,0 +1,77 @@
+"""Nonblocking receive side of the GUI-owned heartbeat pipe."""
+
+import os
+import select
+import time
+
+from core import Abort
+
+
+HEARTBEAT_TIMEOUT_NS = 500_000_000
+
+
+def milliseconds(nanoseconds):
+    return None if nanoseconds is None else nanoseconds / 1_000_000
+
+
+class PipeHeartbeat:
+    def __init__(self, fd, record):
+        self.fd = fd
+        self.record = record
+        self.buffer = b''
+        self.last_sent = None
+        self.last_received = None
+        os.set_blocking(fd, False)
+
+    def abort(self, detail, now):
+        self.record(dict(kind='heartbeat_failure', detail=detail, mono_ns=now,
+                         last_gui_mono_ns=self.last_sent,
+                         last_received_mono_ns=self.last_received,
+                         age_ms=milliseconds(None if self.last_sent is None else now-self.last_sent)))
+        raise Abort(f'upper-computer heartbeat {detail}')
+
+    def receive(self):
+        # Bound the work even if a malfunctioning sender floods the pipe.
+        for _ in range(4):
+            try:
+                data = os.read(self.fd, 4096)
+            except BlockingIOError:
+                return
+            now = time.monotonic_ns()
+            if not data:
+                self.abort('pipe closed', now)
+            *lines, self.buffer = (self.buffer+data).split(b'\n')
+            if len(self.buffer) > 20:
+                self.abort('invalid pipe message', now)
+            for line in lines:
+                if not 1 <= len(line) <= 20 or not line.isdigit():
+                    self.abort('invalid pipe message', now)
+                sent = int(line)
+                if sent > now or (self.last_sent is not None and sent <= self.last_sent):
+                    self.abort('invalid timestamp', now)
+                gap = None if self.last_sent is None else sent-self.last_sent
+                receive_gap = None if self.last_received is None else now-self.last_received
+                self.record(dict(kind='heartbeat', mono_ns=now, gui_mono_ns=sent,
+                                 interval_ms=milliseconds(gap),
+                                 receive_interval_ms=milliseconds(receive_gap),
+                                 pipe_delay_ms=milliseconds(now-sent)))
+                if gap is not None and gap >= HEARTBEAT_TIMEOUT_NS:
+                    self.abort('lost', now)
+                self.last_sent = sent
+                self.last_received = now
+        self.abort('pipe backlog', time.monotonic_ns())
+
+    def check(self):
+        self.receive()
+        now = time.monotonic_ns()
+        if self.last_sent is None or now-self.last_sent >= HEARTBEAT_TIMEOUT_NS:
+            self.abort('lost', now)
+
+    def wait_ready(self):
+        deadline = time.monotonic_ns()+HEARTBEAT_TIMEOUT_NS
+        while self.last_sent is None:
+            remaining = (deadline-time.monotonic_ns()) / 1e9
+            if remaining <= 0 or not select.select([self.fd], [], [], remaining)[0]:
+                self.abort('not received before startup', time.monotonic_ns())
+            self.receive()
+        self.check()
